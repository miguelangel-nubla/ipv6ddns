{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Technitium DNS Server, through its HTTP API.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "address": {
            "type": "string",
            "minLength": 1,
            "description": "Its address, as http://127.0.0.1:5380."
        },
        "tls_fingerprint": {
            "type": "string",
            "pattern": "^([a-fA-F0-9]{2}(:?[a-fA-F0-9]{2}){31})?$",
            "description": "The SHA-256 fingerprint of the server's certificate, as 64 hex digits, colons allowed, for when it can't be verified otherwise. Without it, the certificate must be valid."
        },
        "token": {
            "type": "string",
            "minLength": 1,
            "description": "An API token."
        },
        "zone": {
            "type": "string",
            "minLength": 1,
            "description": "The zone."
        },
        "ttl": {
            "type": "string",
            "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
            "description": "The records' TTL, as 5m or 1h."
        }
    },
    "required": [
        "address",
        "token",
        "zone",
        "ttl"
    ]
}
