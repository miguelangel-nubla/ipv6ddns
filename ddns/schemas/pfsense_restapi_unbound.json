{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "pfSense's Unbound host overrides, over the REST API package.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "address": {
            "type": "string",
            "minLength": 1,
            "description": "Its address: https://pfsense.lan."
        },
        "tls_fingerprint": {
            "type": "string",
            "pattern": "^([a-fA-F0-9]{64})?$",
            "description": "The SHA-256 fingerprint of the server's certificate, in hex, when it can't be verified otherwise. Without it, the certificate must be valid."
        },
        "key": {
            "type": "string",
            "minLength": 1,
            "description": "An API key."
        },
        "zone": {
            "type": "string",
            "minLength": 1,
            "description": "The zone of the names."
        },
        "ttl": {
            "type": "string",
            "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
            "description": "Unused: pfSense's host overrides have no TTL of their own. Kept so that the configurations giving it load."
        }
    },
    "required": [
        "address",
        "key",
        "zone"
    ]
}
