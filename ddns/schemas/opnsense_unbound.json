{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "OPNsense's Unbound host overrides, through its API.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "address": {
            "type": "string",
            "minLength": 1,
            "description": "Its address, as https://opnsense.lan."
        },
        "tls_fingerprint": {
            "type": "string",
            "pattern": "^([a-fA-F0-9]{64})?$",
            "description": "The SHA-256 fingerprint of the server's certificate, in hex, for when it can't be verified otherwise. Without it, the certificate must be valid."
        },
        "key": {
            "type": "string",
            "minLength": 1,
            "description": "An API key."
        },
        "secret": {
            "type": "string",
            "minLength": 1,
            "description": "Its secret."
        },
        "zone": {
            "type": "string",
            "description": "The zone of the names."
        },
        "ttl": {
            "type": "string",
            "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
            "description": "The records' TTL, as 5m or 1h."
        }
    },
    "required": [
        "address",
        "key",
        "secret",
        "zone",
        "ttl"
    ]
}
