{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "Gravity, a DNS server for the home network, over its API.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "server": {
            "type": "string",
            "minLength": 1,
            "description": "Its address: http://gravity.lan."
        },
        "api_key": {
            "type": "string",
            "minLength": 1,
            "description": "An API key."
        },
        "zone": {
            "type": "string",
            "minLength": 1,
            "description": "The zone, with its final dot: home.lan."
        },
        "ttl": {
            "type": "string",
            "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
            "description": "Unused: Gravity has no TTL per record. Kept so that the configurations giving it load."
        }
    },
    "required": [
        "server",
        "api_key",
        "zone"
    ]
}
