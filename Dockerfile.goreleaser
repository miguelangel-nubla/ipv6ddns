# Two images from one: ipv6ddns, and the Home Assistant add-on, which is the same started from the
# add-on's options. goreleaser builds each with its --target.

FROM alpine:3.22 AS ipv6ddns

# The tools the scripts of command sources usually need.
RUN apk add --no-cache \
    bash \
    iputils \
    iproute2 \
    curl \
    ca-certificates \
    bind-tools \
    jq \
    && update-ca-certificates

ARG TARGETPLATFORM
COPY $TARGETPLATFORM/ipv6ddns /usr/local/bin/ipv6ddns

# The configuration is config.yaml of the working directory, unless -config_file says: /config.yaml.
WORKDIR /

ENTRYPOINT ["ipv6ddns"]

FROM ipv6ddns AS addon

COPY homeassistant/run.sh /run.sh
COPY homeassistant/starter.config.yaml /usr/share/ipv6ddns/config.yaml

ENTRYPOINT ["/run.sh"]
