#!/sbin/openrc-run
# ipv6ddns as a service of OpenRC, as its package for Alpine installs it.

name="ipv6ddns"
description="DNS names for every device on your network, on the LAN and on the internet, wherever its addresses move"

# It stays in the foreground, and its supervisor starts it again when it ends by itself.
supervisor="supervise-daemon"
command="/usr/bin/ipv6ddns"
command_args="--config /etc/ipv6ddns/config.yaml"
respawn_delay=5

# It runs as root, for the raw sockets discovery listens and probes with and for a resolver at
# 53, and so its configuration, which has the credentials, is root's alone to read.
no_new_privs="yes"

# The log goes to syslog: /var/log/messages, as Alpine has it.
output_logger="logger -t ipv6ddns -p daemon.info"
error_logger="logger -t ipv6ddns -p daemon.info"

# The updates running get 30 seconds to end, and then the process ends by itself.
retry="TERM/40/KILL/5"

depend() {
	need net
	use dns logger
	after firewall
}
