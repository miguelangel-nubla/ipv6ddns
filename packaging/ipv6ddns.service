# ipv6ddns as a service of systemd, as its packages install it.
#
# To change it, don't edit this file, which an upgrade replaces: systemctl edit ipv6ddns.
[Unit]
Description=ipv6ddns: DNS names for every device on your network, on the LAN and on the internet, wherever its addresses move
Documentation=man:ipv6ddns(1) https://github.com/miguelangel-nubla/ipv6ddns/blob/main/docs/README.md
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/ipv6ddns --config /etc/ipv6ddns/config.yaml
Restart=on-failure
RestartSec=5s
# The updates running get 30 seconds to end, and then the process ends by itself.
TimeoutStopSec=40s

# It runs as root with two capabilities, and no other: raw sockets, which discovery listens and
# probes with, and the ports under 1024, for a resolver at 53. So its configuration, which has
# the credentials, is root's alone to read.
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# The file system is read only, but for the configuration's folder, where it keeps what it
# writes: the certificates, the blocklists' copies, the key Home Assistant gives. And for
# /var/lib/ipv6ddns, for a state_dir there.
ProtectSystem=strict
ReadWritePaths=/etc/ipv6ddns
StateDirectory=ipv6ddns
StateDirectoryMode=0700
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# The sockets of discovery, of the neighbor tables and of the providers, and no other.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_PACKET AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
