{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "tasks": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "filter": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "mac": {
                                    "type": "object",
                                    "properties": {
                                        "address": {
                                            "type": "string"
                                        },
                                        "mask": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "type": {
                                            "type": "array",
                                            "items": {
                                                "type": "string",
                                                "enum": [
                                                    "local",
                                                    "global",
                                                    "unicast",
                                                    "multicast"
                                                ]
                                            }
                                        }
                                    },
                                    "additionalProperties": false
                                },
                                "ip": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "array",
                                            "items": {
                                                "type": "string",
                                                "enum": [
                                                    "eui64",
                                                    "random",
                                                    "global",
                                                    "private",
                                                    "ula",
                                                    "cgnat",
                                                    "link_local"
                                                ]
                                            }
                                        },
                                        "prefix": {
                                            "type": "string"
                                        },
                                        "suffix": {
                                            "type": "string"
                                        },
                                        "mask": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "family": {
                                            "type": "array",
                                            "items": {
                                                "type": "integer",
                                                "enum": [
                                                    4,
                                                    6
                                                ]
                                            },
                                            "description": "4, 6 or both. Default: 6."
                                        }
                                    },
                                    "additionalProperties": false
                                },
                                "source": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "endpoints": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "ipv4": {
                        "type": "object",
                        "properties": {
                            "interval": {
                                "type": "string",
                                "pattern": "^(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|ms|s|m|h))+)$",
                                "description": "The interval at which to check for changes."
                            },
                            "command": {
                                "type": "string",
                                "description": "The command to execute."
                            },
                            "args": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Command arguments"
                            },
                            "lifetime": {
                                "type": "string",
                                "pattern": "^(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|ms|s|m|h))+)$",
                                "description": "Time to keep a IPv4 host entry after it has been last received"
                            }
                        },
                        "required": [
                            "interval",
                            "command",
                            "lifetime"
                        ],
                        "additionalProperties": false,
                        "description": "Deprecated: a command source, in sources."
                    },
                    "sources": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "The sources whose addresses the task's names get too."
                    }
                },
                "required": [
                    "endpoints"
                ],
                "additionalProperties": false
            }
        },
        "credentials": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "provider": {
                        "type": "string"
                    },
                    "settings": {
                        "type": "object"
                    },
                    "debounce_time": {
                        "type": "string",
                        "pattern": "^(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|ms|s|m|h))+)$"
                    },
                    "retry_time": {
                        "type": "string",
                        "pattern": "^(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|ms|s|m|h))+)$"
                    }
                },
                "required": [
                    "provider",
                    "settings"
                ],
                "additionalProperties": false
            }
        },
        "discovery": {
            "type": "object",
            "properties": {
                "listen": {
                    "type": "boolean"
                },
                "active": {
                    "type": "boolean"
                },
                "solicit_eui64": {
                    "type": "boolean"
                },
                "plugins": {
                    "type": "object",
                    "patternProperties": {
                        ".+": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "linux",
                                        "freebsd",
                                        "mikrotik"
                                    ]
                                },
                                "params": {
                                    "type": "string",
                                    "description": "The plugin params in one string, as for ipv6disc: or the fields below."
                                },
                                "interval": {
                                    "type": "string",
                                    "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$"
                                },
                                "address": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "username": {
                                    "type": "string"
                                },
                                "password": {
                                    "type": "string"
                                },
                                "identity_file": {
                                    "type": "string",
                                    "description": "linux and freebsd: the SSH private key."
                                },
                                "host_key": {
                                    "type": "string",
                                    "pattern": "^(SHA256:[A-Za-z0-9+/]{43})?$",
                                    "description": "linux and freebsd: the fingerprint of the host's SSH key."
                                },
                                "use_tls": {
                                    "type": "boolean",
                                    "description": "mikrotik: the API over TLS."
                                },
                                "tls_fingerprint": {
                                    "type": "string",
                                    "description": "mikrotik: the SHA-256 fingerprint of the router's certificate."
                                }
                            },
                            "required": [
                                "type"
                            ],
                            "oneOf": [
                                {
                                    "required": [
                                        "params"
                                    ],
                                    "not": {
                                        "anyOf": [
                                            {
                                                "required": [
                                                    "interval"
                                                ]
                                            },
                                            {
                                                "required": [
                                                    "address"
                                                ]
                                            },
                                            {
                                                "required": [
                                                    "username"
                                                ]
                                            },
                                            {
                                                "required": [
                                                    "password"
                                                ]
                                            },
                                            {
                                                "required": [
                                                    "identity_file"
                                                ]
                                            },
                                            {
                                                "required": [
                                                    "host_key"
                                                ]
                                            },
                                            {
                                                "required": [
                                                    "use_tls"
                                                ]
                                            },
                                            {
                                                "required": [
                                                    "tls_fingerprint"
                                                ]
                                            }
                                        ]
                                    }
                                },
                                {
                                    "required": [
                                        "interval",
                                        "address",
                                        "username"
                                    ],
                                    "not": {
                                        "required": [
                                            "params"
                                        ]
                                    }
                                }
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "ipv4": {
                    "type": "boolean",
                    "description": "Discover IPv4 neighbors too: the plugins' ARP tables, and the kernel's. Filters take them only with ip.family 4."
                }
            },
            "additionalProperties": false
        },
        "sources": {
            "type": "object",
            "description": "Named sources of addresses without a MAC: the public address of the network, a command's output, a fixed list.",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "http",
                            "dns",
                            "command",
                            "static"
                        ]
                    },
                    "family": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "enum": [
                                4,
                                6
                            ]
                        },
                        "description": "http and dns: the families to find. Default: 4."
                    },
                    "interval": {
                        "type": "string",
                        "pattern": "^(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|ms|s|m|h))+)$",
                        "description": "How often it runs. Default: 5m."
                    },
                    "lifetime": {
                        "type": "string",
                        "pattern": "^(0|([0-9]*(\\.[0-9]*)?(ns|us|µs|ms|s|m|h))+)$",
                        "description": "How long an address stays after the last run that gave it. Default: 3 intervals."
                    },
                    "urls": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "pattern": "^https?://"
                        },
                        "description": "http: the echo services to ask, in order."
                    },
                    "command": {
                        "type": "string"
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "addresses": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "static: the addresses."
                    }
                },
                "required": [
                    "type"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "tasks",
        "credentials"
    ],
    "additionalProperties": false
}