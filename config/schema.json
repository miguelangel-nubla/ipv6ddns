{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "tasks": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "filter": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "self": {
                                    "type": "boolean",
                                    "description": "The addresses of the machine ipv6ddns runs on, on the interfaces discovery runs on, rather than of a MAC: a Home Assistant host, a server. With the family's listen."
                                },
                                "mac": {
                                    "type": "object",
                                    "properties": {
                                        "address": {
                                            "type": "string",
                                            "description": "The MAC address, exactly: 00:11:22:33:44:55."
                                        },
                                        "mask": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "description": "VALUE/MASK pairs, all of which the MAC must match: 00:11:22:00:00:00/ff:ff:ff:00:00:00 for a vendor's."
                                        },
                                        "type": {
                                            "type": "array",
                                            "items": {
                                                "type": "string",
                                                "enum": [
                                                    "local",
                                                    "global",
                                                    "unicast",
                                                    "multicast",
                                                    "!local",
                                                    "!global",
                                                    "!unicast",
                                                    "!multicast"
                                                ]
                                            },
                                            "description": "MAC types, all of which must apply: global, local, unicast, multicast. \"!type\": not of the type."
                                        }
                                    },
                                    "additionalProperties": false,
                                    "description": "Rules on the MAC address of the host."
                                },
                                "ip": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "type": "array",
                                            "items": {
                                                "type": "string",
                                                "enum": [
                                                    "global",
                                                    "private",
                                                    "ula",
                                                    "cgnat",
                                                    "link_local",
                                                    "eui64",
                                                    "random",
                                                    "temporary",
                                                    "!global",
                                                    "!private",
                                                    "!ula",
                                                    "!cgnat",
                                                    "!link_local",
                                                    "!eui64",
                                                    "!random",
                                                    "!temporary"
                                                ]
                                            },
                                            "description": "Address types, all of which must apply: global, private, ula, cgnat, link_local, eui64 (IPv6 from the MAC, stable), random (IPv6, not from the MAC), temporary (an IPv6 privacy address of this machine's, which changes every day or so). \"!type\": not of the type, as \"!temporary\"."
                                        },
                                        "prefix": {
                                            "type": "string",
                                            "description": "A prefix the address must be in: 2001:db8::/32, 192.168.1.0/24."
                                        },
                                        "suffix": {
                                            "type": "string",
                                            "description": "The end of the address, in its canonical lower case form: ::1, dead:beef."
                                        },
                                        "mask": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "description": "VALUE/MASK pairs, all of which the address must match."
                                        },
                                        "family": {
                                            "type": "array",
                                            "items": {
                                                "type": "integer",
                                                "enum": [
                                                    4,
                                                    6
                                                ]
                                            },
                                            "description": "4, 6 or both. Default: 6."
                                        }
                                    },
                                    "additionalProperties": false,
                                    "description": "Rules on the address."
                                },
                                "source": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    },
                                    "description": "Names of what must all have seen the address: discovery plugins, or local interfaces."
                                }
                            },
                            "additionalProperties": false
                        },
                        "description": "Filter sets: an address any of them matches is the task's. Within a set, every rule must match."
                    },
                    "endpoints": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "description": "The host names to update, by credential: a name in the credential's zone, \"\" for the zone itself, \"*.name\" for a wildcard."
                    },
                    "ipv4": {
                        "type": "object",
                        "properties": {
                            "interval": {
                                "$ref": "#/$defs/duration",
                                "description": "How often the command runs."
                            },
                            "command": {
                                "type": "string",
                                "description": "The command, printing the addresses one per line."
                            },
                            "args": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Its arguments."
                            },
                            "lifetime": {
                                "$ref": "#/$defs/duration",
                                "description": "How long an address stays after the last run that gave it."
                            }
                        },
                        "required": [
                            "interval",
                            "command",
                            "lifetime"
                        ],
                        "additionalProperties": false,
                        "description": "Deprecated, and goes in v1.0: a command source, in sources, does the same."
                    },
                    "sources": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "The sources whose addresses the task's names get too."
                    }
                },
                "required": [
                    "endpoints"
                ],
                "additionalProperties": false
            },
            "description": "The host names to keep, by task name: the addresses its filters match, and those of the sources it names, go to the host names of its endpoints."
        },
        "credentials": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "provider": {
                        "type": "string",
                        "description": "The DNS provider: see the providers reference."
                    },
                    "settings": {
                        "type": "object",
                        "description": "The provider's settings: see the providers reference. An unknown one is an error."
                    },
                    "debounce": {
                        "$ref": "#/$defs/duration",
                        "description": "How long to wait for more changes before updating. Default: 10s."
                    },
                    "retry": {
                        "$ref": "#/$defs/duration",
                        "description": "How long to wait before retrying a failed update. Default: 1m."
                    },
                    "debounce_time": {
                        "$ref": "#/$defs/duration",
                        "description": "Deprecated, and goes in v1.0: debounce."
                    },
                    "retry_time": {
                        "$ref": "#/$defs/duration",
                        "description": "Deprecated, and goes in v1.0: retry."
                    }
                },
                "required": [
                    "provider",
                    "settings"
                ],
                "additionalProperties": false
            },
            "description": "The DNS providers to update, by credential name, which tasks' endpoints name."
        },
        "discovery": {
            "type": "object",
            "properties": {
                "ipv6": {
                    "$ref": "#/$defs/family",
                    "description": "IPv6 discovery: true, false, or the ways. Default: listen and active."
                },
                "ipv4": {
                    "$ref": "#/$defs/family",
                    "description": "IPv4 discovery: true, false, or the ways. Default: off. Filters take IPv4 addresses only with ip.family 4."
                },
                "plugins": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/plugin"
                    },
                    "description": "Plugins reading the neighbor tables of routers and hosts, by name."
                },
                "listen": {
                    "type": "boolean",
                    "description": "Deprecated, and goes in v1.0: discovery.ipv6.listen, and ipv4.listen unless ipv4 has its ways."
                },
                "active": {
                    "type": "boolean",
                    "description": "Deprecated, and goes in v1.0: discovery.ipv6.active, and ipv4.active unless ipv4 has its ways."
                },
                "solicit_eui64": {
                    "type": "boolean",
                    "description": "Deprecated, and goes in v1.0: discovery.ipv6.solicit."
                },
                "interfaces": {
                    "$ref": "#/$defs/stringList",
                    "description": "The interfaces the local discovery of both families runs on: names, or patterns as en*. Default: all."
                },
                "exclude_interfaces": {
                    "$ref": "#/$defs/stringList",
                    "description": "The interfaces the local discovery doesn't run on: names, or patterns as docker*, veth*."
                },
                "rediscover": {
                    "$ref": "#/$defs/duration",
                    "description": "How often the active discovery probes every host. Default: a third of the shortest lifetime of the families that probe."
                }
            },
            "additionalProperties": false,
            "description": "How hosts are discovered: on the local links, and by plugins reading routers' tables."
        },
        "sources": {
            "type": "object",
            "description": "Sources of addresses without a MAC, as the network's public IPv4, by name, which tasks name in their sources.",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "http",
                            "dns",
                            "command",
                            "static",
                            "homeassistant"
                        ],
                        "description": "dns: the public address, as OpenDNS's or Google's resolvers see it. http: from echo services over HTTPS, or urls. command: the addresses a command prints, one per line. static: the addresses listed. homeassistant: the addresses in a Home Assistant entity's state, which needs the homeassistant block."
                    },
                    "family": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "enum": [
                                4,
                                6
                            ]
                        },
                        "description": "http and dns: the families to find. Default: 4."
                    },
                    "interval": {
                        "$ref": "#/$defs/duration",
                        "description": "How often it runs. Default: 5m."
                    },
                    "lifetime": {
                        "$ref": "#/$defs/duration",
                        "description": "How long an address stays after the last run that gave it. Default: 3 intervals."
                    },
                    "urls": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "pattern": "^https?://"
                        },
                        "description": "http: the echo services to ask, in order."
                    },
                    "command": {
                        "type": "string",
                        "description": "command: the program to run, from the configuration's directory."
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "command: its arguments."
                    },
                    "addresses": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "static: the addresses."
                    },
                    "entity": {
                        "type": "string",
                        "pattern": "^[a-z_]+\\.[a-z0-9_]+$",
                        "description": "homeassistant: the entity, as sensor.wan_ip."
                    },
                    "attribute": {
                        "type": "string",
                        "minLength": 1,
                        "description": "homeassistant: the attribute of the entity to read, rather than its state."
                    }
                },
                "required": [
                    "type"
                ],
                "additionalProperties": false
            }
        },
        "lifetime": {
            "$ref": "#/$defs/duration",
            "description": "How long a discovered address stays after it was last seen, unless its family says. Default: 1h. The -lifetime flag, given, wins."
        },
        "log_level": {
            "type": "string",
            "enum": [
                "debug",
                "info",
                "warn",
                "error",
                "dpanic",
                "panic",
                "fatal"
            ],
            "description": "The logging level. Default: info. The -log_level flag, given, wins."
        },
        "webserver": {
            "type": "object",
            "additionalProperties": false,
            "description": "The web server: the report, /status.json and /metrics.",
            "properties": {
                "listen": {
                    "$ref": "#/$defs/stringList",
                    "description": "Where to serve: ports, addresses, networks of the machine's addresses and host names: 8053, 192.0.2.1:8053, [2001:db8::1]:8053, 10.2.3.0/24, myhost; without a port, 80. A host name listens on each address it resolves to, at start; a network, on each address of the machine in it. The -webserver_listen flag, given, wins."
                }
            }
        },
        "webserver_listen": {
            "$ref": "#/$defs/stringList",
            "description": "Deprecated, and goes in v1.0: webserver.listen."
        },
        "homeassistant": {
            "type": "object",
            "additionalProperties": false,
            "description": "Makes ipv6ddns a device of Home Assistant's ESPHome integration: Home Assistant discovers it, and shows each name's addresses, last update and problems, and the hosts discovered, with a button to update now; and it sends the states homeassistant sources read. See docs/home-assistant-integration.md.",
            "properties": {
                "key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9+/]{43}=$",
                    "description": "The encryption key: the base64 of 32 bytes, which Home Assistant asks when adding the device, and can't change. Without it, Home Assistant makes the key and gives it, as to ESPHome's devices: it is kept in state_file."
                },
                "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([a-z0-9-]{0,29}[a-z0-9])?$",
                    "description": "The device's name in the network: lower case letters, digits and hyphens. Default: ipv6ddns."
                },
                "friendly_name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The name Home Assistant shows. Default: the name."
                },
                "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "description": "The port Home Assistant connects to. Default: 6053, ESPHome's."
                },
                "announce": {
                    "type": "boolean",
                    "description": "Whether the device announces itself by mDNS, for Home Assistant to find it. Without, add it by its address. Default: true."
                },
                "listen": {
                    "$ref": "#/$defs/stringList",
                    "description": "Where the device listens, and announces itself, on the interfaces that hold those addresses: ports, addresses, networks of the machine's addresses and host names: 8053, 192.0.2.1:8053, [2001:db8::1]:8053, 10.2.3.0/24, myhost; without a port, port. Only where Home Assistant can reach it, when the machine is on other networks too, as a container on several: 10.2.3.0/24. Default: every address, announced on the interfaces discovery runs on."
                },
                "state_file": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Without a key: where the device keeps its identity, by which Home Assistant knows it, and the key Home Assistant gave. A file ipv6ddns can write; relative, from the configuration's folder. Default: homeassistant.state. Deleting it makes the device a new one, without a key."
                }
            }
        }
    },
    "required": [
        "tasks",
        "credentials"
    ],
    "additionalProperties": false,
    "$defs": {
        "duration": {
            "description": "A duration, as 90s, 1m30s or 1h, or a number of seconds.",
            "oneOf": [
                {
                    "$ref": "#/$defs/durationString"
                },
                {
                    "type": "number",
                    "minimum": 0
                }
            ]
        },
        "stringList": {
            "description": "A list, or one string of comma separated values. Numbers, as ports, are taken as written.",
            "oneOf": [
                {
                    "type": [
                        "string",
                        "integer"
                    ]
                },
                {
                    "type": "array",
                    "items": {
                        "type": [
                            "string",
                            "integer"
                        ],
                        "minLength": 1
                    }
                }
            ]
        },
        "family": {
            "description": "How a family is discovered: true, false, or an object of the ways, each defaulting as true sets it.",
            "oneOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Whether the family is discovered at all. Default: true in an object."
                        },
                        "listen": {
                            "type": "boolean",
                            "description": "Passive local discovery: NDP for IPv6, the kernel's neighbor table for IPv4. Active probing and IPv6 solicitation need it. Default: true."
                        },
                        "active": {
                            "type": "boolean",
                            "description": "Probing every host: multicast for IPv6, a broadcast ARP sweep for IPv4. Default: true."
                        },
                        "solicit": {
                            "type": "boolean",
                            "description": "Asking the hosts the filters want: their EUI-64 address for IPv6, ARP to their MAC alone for IPv4. Default: false."
                        },
                        "lifetime": {
                            "$ref": "#/$defs/duration",
                            "description": "How long the family's addresses stay after they were last seen, whatever found them. Default: the top-level lifetime."
                        }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "sshPlugin": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "The plugin type."
                },
                "params": {
                    "type": "string",
                    "description": "Deprecated, and goes in v1.0: the params in one string, as for ipv6disc. Give the fields instead."
                },
                "interval": {
                    "$ref": "#/$defs/durationString"
                },
                "address": {
                    "type": "string",
                    "minLength": 1
                },
                "username": {
                    "type": "string",
                    "minLength": 1
                },
                "password": {
                    "type": "string"
                },
                "identity_file": {
                    "type": "string",
                    "minLength": 1
                },
                "host_key": {
                    "type": "string",
                    "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
                }
            },
            "additionalProperties": false,
            "description": "A plugin over SSH, linux or freebsd: with a password, an identity file, or both.",
            "if": {
                "required": [
                    "params"
                ]
            },
            "else": {
                "required": [
                    "interval",
                    "address",
                    "username"
                ]
            }
        },
        "mikrotikPlugin": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "The plugin type."
                },
                "params": {
                    "type": "string",
                    "description": "Deprecated, and goes in v1.0: the params in one string, as for ipv6disc. Give the fields instead."
                },
                "interval": {
                    "$ref": "#/$defs/durationString"
                },
                "address": {
                    "type": "string",
                    "minLength": 1
                },
                "username": {
                    "type": "string",
                    "minLength": 1
                },
                "password": {
                    "type": "string"
                },
                "use_tls": {
                    "type": "boolean"
                },
                "tls_fingerprint": {
                    "type": "string",
                    "pattern": "^[0-9A-Fa-f]{2}(:?[0-9A-Fa-f]{2}){31}$"
                }
            },
            "additionalProperties": false,
            "description": "A plugin over the Mikrotik API.",
            "if": {
                "required": [
                    "params"
                ]
            },
            "else": {
                "required": [
                    "interval",
                    "address",
                    "username"
                ]
            }
        },
        "plugin": {
            "type": "object",
            "required": [
                "type"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "linux",
                        "freebsd",
                        "mikrotik"
                    ],
                    "description": "The plugin type: linux or freebsd (pfSense, OPNsense) over SSH, mikrotik over its API."
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "enum": [
                                    "linux",
                                    "freebsd"
                                ]
                            }
                        }
                    },
                    "then": {
                        "$ref": "#/$defs/sshPlugin"
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "mikrotik"
                            }
                        }
                    },
                    "then": {
                        "$ref": "#/$defs/mikrotikPlugin"
                    }
                }
            ]
        },
        "durationString": {
            "type": "string",
            "pattern": "^(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|ms|s|m|h))+)$",
            "description": "A duration, as 90s, 1m30s or 1h."
        }
    }
}
